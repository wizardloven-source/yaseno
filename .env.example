# ===========================
# YAseen ERP - Environment Variables
# ===========================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/erpya
ECHO_SQL=false

# ===========================
# Security
# ===========================
# Generate a strong secret key (use: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET

# ===========================
# Authentication
# ===========================
ENABLE_AUTH=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================
# Application
# ===========================
ENV=development
DEBUG=true
SEED_DATA=false
ADMIN_PASSWORD=Admin@123

# ===========================
# CORS (comma-separated origins)
# ===========================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
