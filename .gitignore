```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
pip-log.txt
pip-selfcheck.json

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
.coverage
htmlcov/
.coverage.*
coverage.xml

# IDE specific
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build and distribution artifacts
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```